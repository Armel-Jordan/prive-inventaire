# Nom affiché (provisoire) : expéditeur des courriels de la plateforme, application d'authentification
# (double authentification). Le nom affiché par le site web se règle par VITE_APP_NAME au build du front.
APP_NAME="Prise Inventaire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.prise-inventaire.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prise_central
DB_USERNAME=
DB_PASSWORD=

# Noms Laravel 11+ (CACHE_DRIVER et BROADCAST_DRIVER ne sont plus lus).
BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=prise-inventaire.com,www.prise-inventaire.com
SESSION_DOMAIN=.prise-inventaire.com

CORS_ALLOWED_ORIGINS=https://prise-inventaire.com,https://www.prise-inventaire.com

# Courriels de la plateforme : mot de passe oublié, documents envoyés avec le transport « plateforme ».
# Sans serveur SMTP renseigné, rien ne part (MAIL_MAILER=log les écrit seulement dans le journal) ;
# sans MAIL_FROM_*, l'expéditeur serait « Example <hello@example.com> ».
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Adresse du site web, pour le lien du courriel « mot de passe oublié » quand l'origine envoyée par le
# site ne figure pas dans CORS_ALLOWED_ORIGINS.
FRONTEND_URL=https://prise-inventaire.com
